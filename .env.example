BETTER_AUTH_SECRET=replace-this-with-a-long-random-string
PAPERCLIP_PORT=3100
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_DATA_DIR=./data/docker-paperclip

# Absolute path to the frontend repository you want the agent to edit.
# Windows example: FRONTEND_REPO_DIR=C:/croft/programs/my-frontend-app
# Linux/macOS example: FRONTEND_REPO_DIR=/home/you/work/my-frontend-app
FRONTEND_REPO_DIR=/absolute/path/to/your-frontend-repo

# Optional for public models, required for gated/private Hugging Face models.
HF_TOKEN=
HF_CACHE_DIR=/absolute/path/to/your-huggingface-cache
VLLM_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8
VLLM_API_KEY=dev
VLLM_TENSOR_PARALLEL_SIZE=2
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=1
VLLM_TOOL_CALL_PARSER=qwen3_coder
